# Copy to .dev.vars for wrangler; production uses wrangler secret put.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=SERVER_ONLY_SERVICE_ROLE_KEY
APP_ORIGIN=https://events.futuredoctorinitiative.org
# Random 32+ byte hex key used to hash rate-limit identifiers, SERVER ONLY.
RATE_LIMIT_SECRET=REPLACE_WITH_RANDOM_SECRET

{
  "name": "fdi-events",
  "main": "server/worker.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "observability": { "enabled": false },
  "vars": { "APP_ORIGIN": "https://events.futuredoctorinitiative.org" },
}
